server {
    listen 80;
    server_name localhost;

    # Set maximum upload size to 10MB
    client_max_body_size 10M;

    # Let's Encrypt ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # 重定向所有HTTP请求到HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name localhost;

    # Set maximum upload size to 10MB
    client_max_body_size 10M;

    # SSL配置
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # 强化 SSL 配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # HSTS配置
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Basic security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # 屏蔽常见的攻击路径请求
    location ~ ^/(wp-login\.php|wp-admin|admin|wordpress|wp|phpmyadmin|pma|mysql|myadmin|webdav|xmlrpc\.php|cgi-bin|\.git|\.env) {
        return 404;
        access_log off;
        log_not_found off;
    }

    # 反向代理到Flask应用
    location / {
        proxy_pass http://app:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加默认超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 静态文件处理
    location /static/ {
        proxy_pass http://app:5000/static/;
        expires 7d;
    }

    # 暴露监控指标，可选限制访问
    location /metrics {
        proxy_pass http://app:5000/metrics;
        auth_basic "Metrics Authentication";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }

    # 处理路径图描述流式响应
    location /roadmap/description_stream {
        proxy_pass http://app:5000;
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 处理AI聊天流式响应
    location /aichat/chat {
        proxy_pass http://app:5000;
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # 对于SSE (Server-Sent Events) 特别重要的设置
        proxy_set_header X-Accel-Buffering no;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间，避免长对话被中断
        proxy_read_timeout 300s;
    }

    # 处理路径图创建接口 - 从主题
    location /roadmap/create_from_topic {
        proxy_pass http://app:5000;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 处理路径图创建接口 - 从JD和简历
    location /roadmap/create_from_jd_and_resume {
        proxy_pass http://app:5000;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 处理路径图描述接口
    location /roadmap/description {
        proxy_pass http://app:5000;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 处理职位分析接口
    location /job/analyze {
        proxy_pass http://app:5000;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 处理职业评估接口
    location /assessment/submit_report {
        proxy_pass http://app:5000;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 处理简历优化接口
    location /resume/optimize {
        proxy_pass http://app:5000;

        # 确保继承通用header设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 增加超时时间为5分钟
        proxy_read_timeout 300s;
    }

    # 捕获所有未明确定义的路径，返回404
    location ~ ^/(?!(static|metrics|roadmap|aichat|job|assessment|resume)/) {
        return 404;
        access_log off;
        log_not_found off;
    }
}